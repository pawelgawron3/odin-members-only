<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dropmsg</title>
    <link rel="shortcut icon" href="/top_favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/css/reset.css">
    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/home.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@mdi/font/css/materialdesignicons.min.css">
</head>
<body>
    <%- include("partials/header.ejs") %>

    <main>
        <div class="hero-div">
            <h1 class="title">Welcome to Dropmsg!</h1>
            <h2 class="info">A site where you can leave messages to people and chat with them about anything!</h2>
        </div>
    
        <ul class="home-messages">
            <% messages.forEach((message) => {%>
                <li>
                    <% if(currentUser && currentUser.membership_status) { %>
                        <div class="message-meta">
                            <span><i class="mdi mdi-account"></i> <%= message.username %></span>
                            <span><%= formatDate(message.created_at) %></span>
                        </div>
                    <% } %>
    
                    <h3 class="message-title">
                        <%= message.title %>
                    </h3>
                    <p class="message-text">
                        <%= message.text %>
                    </p>

                    <% if(currentUser && currentUser.is_admin) { %>
                        <form action="/messages/delete/<%= message.id %>" method="POST" class="delete-message-form">
                            <button type="submit" class="delete-message-btn" title="Delete the message">
                                <i class="mdi mdi-delete"></i>
                            </button>
                        </form>
                    <% } %>
                </li>
            <% }) %>
        </ul>
    </main>

    <%- include("partials/footer.ejs") %>

    <script src="/js/header.js"></script>
</body>
</html>